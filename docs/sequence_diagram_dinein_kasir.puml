@startuml sequence_diagram_dinein_kasir
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 4
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.2
skinparam sequenceArrowColor #1E293B
skinparam sequenceLifeLineBorderColor #475569
skinparam sequenceLifeLineBackgroundColor #F1F5F9
skinparam sequenceParticipantBorderColor #334155
skinparam sequenceParticipantBackgroundColor #F8FAFC
skinparam sequenceParticipantFontStyle bold

actor "Kasir" as k
participant "main: FormCheckoutDineIn" as main
participant "ctrl: DineInPaymentController" as ctrl
participant "byr: Pembayaran" as byr
participant "p: Pesanan" as p
participant "db: KoneksiBasisdata" as db

autonumber 1 "<b>0:</b>"

k -> main : 1: pilihMeja(mejaId)
activate main

main -> ctrl : 2: checkout(mejaId)
activate ctrl

ctrl -> db : 3: queryPesananAktifMeja(mejaId)
activate db
db --> ctrl : 4: dataPesananDanTagihan
deactivate db

ctrl --> main : 5: tampilkanRincianTagihan(totalTagihan)
deactivate ctrl

main --> k : 6: formPembayaran
deactivate main

k -> main : 7: masukkanPembayaran(metode, jumlahBayar)
activate main

main -> ctrl : 8: processPayment(mejaId, dataPembayaran)
activate ctrl

ctrl -> db : 9: updateStokBahanBakuKeluar()
activate db
db --> ctrl : 10: stokBahanTelahDipotong
deactivate db

ctrl -> byr : 11: <<create>>
activate byr

byr -> db : 12: insertDataPembayaran()
activate db
db --> byr : 13: pembayaranTersimpan
deactivate db
byr --> ctrl : 14: dataPembayaran
deactivate byr

ctrl -> p : 15: updateStatus(status_pesanan = Selesai, status_bayar = Lunas)
activate p

p -> db : 16: updateStatusPesanan()
activate db
db --> p : 17: pesananSelesai
deactivate db
p --> ctrl : 18: statusPesananUpdated
deactivate p

ctrl -> db : 19: updateStatusMeja(status = KOSONG)
activate db
db --> ctrl : 20: statusMejaKosong
deactivate db

ctrl --> main : 21: pembayaranBerhasil(struk, kembalian)
deactivate ctrl

main --> k : 22: cetakNotaPembayaran
deactivate main

@enduml
