@startuml sequence_diagram_pemesanan_dinein
hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 4
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 1.2
skinparam sequenceArrowColor #1E293B
skinparam sequenceLifeLineBorderColor #475569
skinparam sequenceLifeLineBackgroundColor #F1F5F9
skinparam sequenceParticipantBorderColor #334155
skinparam sequenceParticipantBackgroundColor #F8FAFC
skinparam sequenceParticipantFontStyle bold

actor "Konsumen" as k
participant "main: FormMenuDineIn" as main
participant "ctrl: QrMenuController" as ctrl
participant "p: Pesanan" as p
participant "t: TiketDapur" as t
participant "db: KoneksiBasisdata" as db
actor "Tim Dapur" as d

autonumber 1 "<b>0:</b>"

k -> main : 1: scanQrMeja(tokenMeja)
activate main

main -> ctrl : 2: getMenuDineIn(tokenMeja)
activate ctrl

ctrl -> db : 3: queryDataMejaDanMenu()
activate db
db --> ctrl : 4: dataMejaDanMenu
deactivate db

ctrl --> main : 5: tampilkanMenuDineIn(menus, meja)
deactivate ctrl

main --> k : 6: daftarMenuDineIn
deactivate main

k -> main : 7: masukkanPesanan(itemMenu, qty, namaPemesan)
activate main

main -> ctrl : 8: storeOrder(mejaId, namaKonsumen, items)
activate ctrl

ctrl -> db : 9: cekKetersediaanStokBahan()
activate db
db --> ctrl : 10: stokCukup (true)
deactivate db

ctrl -> p : 11: <<create>>
activate p

p -> db : 12: insertPesananDanDetail()
activate db
db --> p : 13: pesananTersimpan
deactivate db
p --> ctrl : 14: dataPesanan
deactivate p

ctrl -> t : 15: <<create>>
activate t

t -> db : 16: insertTiketDapur()
activate db
db --> t : 17: tiketDapurTersimpan
deactivate db
t --> ctrl : 18: dataTiketDapur
deactivate t

ctrl -> db : 19: updateStatusMeja(status = TERISI)
activate db
db --> ctrl : 20: statusMejaTerisi
deactivate db

ctrl --> main : 21: konfirmasiPesananBerhasil(kodePesanan)
deactivate ctrl

main -> d : 22: cetakStrukDapur(nomorMeja, itemPesanan, catatan)

main --> k : 23: strukKonfirmasiPemesanan
deactivate main

@enduml
